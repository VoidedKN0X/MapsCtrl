<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind Compose: the Ctrl background, edge to edge. -->
    <style name="Theme.MapsCtrl" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
    </style>
</resources>
